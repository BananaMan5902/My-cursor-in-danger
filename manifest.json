{
  "manifest_version": 3,
  "name": "Stickman Cursor Fighter",
  "version": "1.0",
  "description": "A stickman that fights your cursor.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
